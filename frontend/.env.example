# ═══════════════════════════════════════════════════════════════════
# Paragon frontend — environment template (Vite)
# Copy to `frontend/.env` for local dev. In production these are set in
# Vercel → Project → Settings → Environment Variables.
#
# ⚠️  Everything with the VITE_ prefix is baked into the PUBLIC client bundle.
#     Never put secrets, private keys, or the JWT secret here.
# ═══════════════════════════════════════════════════════════════════

# Backend base URL. [required in prod]
# Dev: leave blank (defaults to http://localhost:8000).
# Prod (Vercel): your Render URL, e.g. https://paragon-api.onrender.com
VITE_API_URL=http://localhost:8000

# Cloudinary — PUBLIC values for direct-from-browser (unsigned) uploads.
# Optional: when blank, uploads route through the backend instead.
# The preset MUST be an "Unsigned" upload preset in your Cloudinary dashboard.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ── Firebase Authentication (PUBLIC web config) ──────────────────────
# From Firebase Console → Project settings → Your apps → Web app → SDK config.
# These are PUBLIC by design (safe in the client bundle). When all four core
# values are set, the app uses Firebase Auth (email/password + Google, with
# verification + password-reset emails sent by Firebase — no SMTP needed).
# Leave blank to use the legacy email/password + dev flow (zero setup).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
