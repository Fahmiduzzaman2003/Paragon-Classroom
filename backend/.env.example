# ═══════════════════════════════════════════════════════════════════
# Paragon backend — environment template
# Copy to `backend/.env` and fill in. Every var has a safe default so the
# app runs out-of-the-box locally (mock LLM, local storage, SQLite).
#
# IMPORTANT: never put a comment on the SAME line as a value — python-dotenv
# reads the whole line, so `KEY=value  # note` sets KEY to "value  # note".
# Keep comments on their own lines (like this file does).
#
# Legend:  [required in prod]  = you MUST set this on Render for production.
#          [auto]              = Render/Neon provides it; don't hand-set.
# ═══════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────
# development | staging | production   (production/staging fail-fast on missing vars)
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
# Render injects $PORT; locally 8000 is fine. [auto on Render]
APP_PORT=8000

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated allowlist of frontend origins. [required in prod]
# In dev, any localhost/127.0.0.1 port is auto-allowed, so this can stay blank.
# Prod example: https://paragon.vercel.app,https://paragon-git-main-you.vercel.app
CORS_ORIGINS=

# ── Security ─────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Blank in dev = ephemeral secret (tokens reset each restart). [required in prod]
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14

# ── Email verification ───────────────────────────────────────────────
# false = skip verification entirely (handy for demos with no SMTP).
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_TOKEN_TTL_MIN=1440

# ── SMTP (optional) ──────────────────────────────────────────────────
# Blank = verification links print to the server console (free/offline dev).
# Free option: https://mailtrap.io (500 emails/month, no card).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@paragon.local
SMTP_FROM_NAME=Paragon
SMTP_USE_TLS=true

# ── Rate limits (slowapi syntax, per client IP) ──────────────────────
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=10/hour
FORGOT_RATE_LIMIT=5/hour
UPLOAD_RATE_LIMIT=30/minute
LLM_RATE_LIMIT=30/minute

# ── Firebase Authentication ──────────────────────────────────────────
# Set to your Firebase project id to verify Firebase ID tokens (email/password
# + Google, with verification/reset emails handled by Firebase — no SMTP). No
# service-account key needed; the project id validates the token audience.
# Leave blank to use the legacy email/password + dev-Google JWT flow.
FIREBASE_PROJECT_ID=

# ── Google OAuth (legacy fallback; only used when Firebase is off) ────
# Create at https://console.cloud.google.com/apis/credentials (Web application).
# Blank = dev fallback (/auth/google/dev mints tokens from an email — dev only).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Comma-separated. In prod set your Vercel callback, e.g.
#   https://paragon.vercel.app/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback,http://127.0.0.1:5173/auth/google/callback
# MUST be false in production (the after-validator enforces this).
GOOGLE_OAUTH_DEV_FALLBACK=true

# ── Database ─────────────────────────────────────────────────────────
# Dev = SQLite. Prod = Neon Postgres (free). [required in prod]
# Neon gives you a URL like postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require
# Convert it to the async driver by using the postgresql+asyncpg scheme:
#   postgresql+asyncpg://user:pass@ep-xxx.neon.tech/db
DATABASE_URL=sqlite+aiosqlite:///./paragon.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE_S=1800

# ── Object storage ───────────────────────────────────────────────────
# local | cloudinary. Blank = local in dev, cloudinary in prod.
# Render's disk is ephemeral, so prod MUST use cloudinary. [required in prod]
STORAGE_BACKEND=
UPLOADS_DIR=./uploads
# From your Cloudinary dashboard. The preset must be an UNSIGNED upload preset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=paragon
MAX_UPLOAD_MB=40
MAX_INGEST_PAGES=50
USER_STORAGE_QUOTA_MB=200

# ── Vector store ─────────────────────────────────────────────────────
# chroma (on-disk, dev only, wiped on Render redeploy) | pgvector (prod).
# pgvector reuses DATABASE_URL — no extra service. [set pgvector in prod]
VECTOR_BACKEND=chroma
CHROMA_PATH=./chroma_data

# ── LLM ──────────────────────────────────────────────────────────────
# Ordered fallback chain "provider:model,provider:model,...".
# Providers: gemini | groq | openrouter | openai | anthropic | mock
# Blank = single provider derived from whichever API key is set (mock if none).
# Recommended free chain:
#   gemini:gemini-2.0-flash,groq:llama-3.3-70b-versatile,openrouter:meta-llama/llama-3.3-70b-instruct:free
LLM_FALLBACK_CHAIN=
# Legacy single-provider selector (used when the chain is blank).
LLM_PROVIDER=mock
LLM_MODEL=
LLM_ATTEMPT_TIMEOUT_S=30
LLM_CHAIN_DEADLINE_S=60
# Daily request caps (0 = unlimited).
LLM_DAILY_USER_CAP=0
LLM_DAILY_GLOBAL_CAP=0
LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_COOLDOWN_S=60

# API keys (set only the ones your chain uses).
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# ── Embeddings ───────────────────────────────────────────────────────
# local (ONNX MiniLM, dev only — heavy on 512 MB) | gemini | openai.
# Prod: use gemini (same GEMINI_API_KEY). [set gemini in prod]
EMBEDDING_PROVIDER=local
# Blank = provider default (gemini -> text-embedding-004).
EMBEDDING_MODEL=

# ── RAG tuning ───────────────────────────────────────────────────────
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=6
RAG_SIMILARITY_FLOOR=0.15

# ── Ingestion worker pool (free tier: no external queue) ─────────────
INGEST_CONCURRENCY=2
INGEST_JOB_TIMEOUT_S=300
INGEST_MAX_ATTEMPTS=3

# ── Observability (optional) ─────────────────────────────────────────
# Set a Sentry DSN (free tier) to enable error tracking. Blank = disabled.
SENTRY_DSN=
