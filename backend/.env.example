# ─────────────────────────────────────────────────────
# Paragon backend — example environment
# Copy to .env and fill in values. Everything has a safe default
# so the app runs out-of-the-box for local demos (mock LLM).
# ─────────────────────────────────────────────────────

# App
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_FRONTEND_ORIGIN=http://localhost:5173

# Security
JWT_SECRET=change-me-please-this-must-be-long-and-random
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14

# Database — defaults to SQLite for dev. Swap for Postgres in prod:
#   postgresql+asyncpg://user:pass@localhost:5432/paragon
DATABASE_URL=sqlite+aiosqlite:///./paragon.db

# Storage
UPLOADS_DIR=./uploads
CHROMA_PATH=./chroma_data

# LLM provider:  openai | openrouter | anthropic | gemini | mock
# "mock" lets the full RAG pipeline demo work without any API keys —
# retrieval is real, the response is deterministically streamed from the
# retrieved context.
LLM_PROVIDER=gemini
LLM_MODEL=                     # defaults per provider if left blank
OPENAI_API_KEY=
OPENAI_BASE_URL=               # optional, e.g. https://api.bluesminds.com/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Embedding provider:  local | openai
# "local" uses ChromaDB's bundled ONNX MiniLM — no network, no keys.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=

# RAG tuning
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=6
